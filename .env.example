# --- App ---
NODE_ENV=production
PORT=3000
APP_NAME=Ciencia y Salud API
APP_URL=https://api.tudominio.com
FRONT_URL=https://tudominio.com
PUBLIC_VERIFY_URL=https://tudominio.com/verificar

# --- Base de datos (MySQL/MariaDB — cPanel) ---
# Formato: mysql://usuario:password@localhost:3306/nombre_bd
DATABASE_URL=mysql://cpanel_user:password@localhost:3306/cpanel_database

# --- Auth (placeholder, se usa desde Sprint 1) ---
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_BCRYPT_COST=12

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email (placeholder, se usa desde Sprint 7) ---
MAIL_DRIVER=resend
MAIL_FROM="Laboratorio <no-reply@laboratorio.com>"
RESEND_API_KEY=

# --- Rate limit ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Logs ---
LOG_LEVEL=info

# --- Admin seed (solo se aplica en `pnpm db:seed`) ---
SEED_ADMIN_EMAIL=admin@laboratorio.com
SEED_ADMIN_PASSWORD=Admin123!
